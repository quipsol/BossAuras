	<s:String x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=E06129052577595FAC4776C2F9B81DC3/Text/@EntryValue">using MegaCrit.Sts2.Core.Entities.Cards;&#xD;&#xA;using MegaCrit.Sts2.Core.HoverTips;&#xD;&#xA;using MegaCrit.Sts2.Core.Localization.DynamicVars;&#xD;&#xA;using BossAuras.Core.Models;&#xD;&#xA;&#xD;&#xA;namespace $NAMESPACE$;&#xD;&#xA;&#xD;&#xA;public class $CLASS$() : BossAurasCardModel(1, MegaCrit.Sts2.Core.Entities.Cards.CardType.$TYPE$, MegaCrit.Sts2.Core.Entities.Cards.CardRarity.$RARITY$, MegaCrit.Sts2.Core.Entities.Cards.TargetType.$TARGET$)&#xD;&#xA;{&#xD;&#xA;    protected override IEnumerable&lt;DynamicVar&gt; CanonicalVars =&gt; [];&#xD;&#xA;    public override IEnumerable&lt;CardKeyword&gt; CanonicalKeywords =&gt; [];&#xD;&#xA;    protected override IEnumerable&lt;IHoverTip&gt; ExtraHoverTips =&gt; [];&#xD;&#xA;    protected override HashSet&lt;CardTag&gt; CanonicalTags =&gt; [];&#xD;&#xA;&#xD;&#xA;    protected override async System.Threading.Tasks.Task OnPlay(MegaCrit.Sts2.Core.GameActions.Multiplayer.PlayerChoiceContext choiceContext, MegaCrit.Sts2.Core.Entities.Cards.CardPlay cardPlay)&#xD;&#xA;    {&#xD;&#xA;        $END$&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    protected override void OnUpgrade() { }&#xD;&#xA;}&#xD;&#xA;</s:String>
